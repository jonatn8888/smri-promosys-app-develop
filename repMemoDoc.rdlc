      <Query>
        <DataSourceName>PromoConnectionString</DataSourceName>
        <CommandText>SELECT Memos.*, Promotions.*, PromoDetails.*
FROM Memos
LEFT JOIN Promotions ON (Memos.MemoID = Promotions.MemoID)
LEFT JOIN PromoDetails ON (Promotions.PromoID = PromoDetails.PromoID)
WHERE Memos.Status = 'Approved'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>dsPromotions</rd:DataSetName>
        <rd:TableName>MemoDocInfo</rd:TableName>
        <rd:TableAdapterName>MemoDocInfoTableAdapter</rd:TableAdapterName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetMemoDocInfo</rd:TableAdapterGetDataMethod>
      </rd:DataSetInfo>
    </DataSet>
