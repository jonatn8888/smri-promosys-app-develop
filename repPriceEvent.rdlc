        </Field>
        <Field Name="BranchName">
          <DataField>BranchName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>PromoConnectionString</DataSourceName>
        <CommandText>SELECT P.RowID, P.TranType, P.BranchCode, P.EventStartDate, P.EventEndDate, P.EventNumber, 	P.EventDesc, P.DeptCode, P.DeptDesc, P.EventReason, 
       	P.Environment, P.EventStatus, P.LastPrintDate, P.PostDate, D.PriceEventID, D.VendorCode, 		D.SubDepCode, 
       	D.ClassCode, D.ClassDesc, D.SKUcode, D.StockDesc1, D.StockDesc2, D.BarCode, D.StyleDesc, 		D.ColorCode, D.SizeCode, D.UnitRetail_Old, 
       	D.UnitRetail_New, B.BranchName
FROM PriceEvents AS P
INNER JOIN PriceEventDetails AS D ON P.RowID = D.PriceEventID
INNER JOIN Branches AS B ON B.BranchCode = P.BranchCode
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>dsPromotions</rd:DataSetName>
        <rd:TableName>PriceEvents</rd:TableName>
        <rd:TableAdapterName>PriceEventsTableAdapter</rd:TableAdapterName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetAllPriceEvents</rd:TableAdapterGetDataMethod>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
