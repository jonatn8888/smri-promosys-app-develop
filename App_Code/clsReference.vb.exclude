        While Dr.Read()
            If Not IsDBNull(Dr("CW_TAG")) Then return_CWTag = Dr("CW_TAG")
        End While

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
#End Region

#Region " Attached Attributes Functions "
    Public Sub Elem_ReadOnly(ByVal elem As WebControl)
        elem.Attributes.Add("OnKeyDown", "disable_key();")
    End Sub
    Public Sub Elem_NumOnly(ByVal elem As WebControl)
        elem.Attributes.Add("OnKeyPress", "numOnly();")
    End Sub
    Public Sub Txt_Disable(ByVal elem As TextBox)
        elem.CssClass = "txtdisable"
        elem.ReadOnly = True
    End Sub
    Public Sub Txt_Enable(ByVal elem As TextBox)
        elem.CssClass = "txtenable"
        elem.ReadOnly = False
    End Sub
    Public Sub Ddl_Enable(ByVal elem As DropDownList)
        elem.CssClass = "ddlenable"
        elem.Enabled = True
    End Sub
    Public Sub Ddl_Unable(ByVal elem As DropDownList)
        elem.CssClass = "ddlunable"
        elem.Enabled = False
    End Sub
    Public Sub txtA_enable(ByVal elem As HtmlTextArea)
        elem.Attributes.Item("readonly") = Nothing
        elem.Attributes.Item("Class") = "txtenable"
    End Sub
    Public Sub txtA_disable(ByVal elem As HtmlTextArea)
        elem.Attributes.Item("readonly") = "readOnly"
        elem.Attributes.Item("Class") = "txtdisable"
    End Sub
    Public Function return_ResCnt(ByVal gv As GridView) As String
        Dim res$ = "0"
        If gv.Rows.Count > 0 Then
            res = gv.Rows.Count.ToString
        End If
        return_ResCnt = "Total Records = " & "<font color='green'>" & res & "</font>"
    End Function
#End Region
End Class
