    Public Function return_CW(ByVal compcode$) As String
        return_CW = String.Empty
        strQry = String.Format("Select brch_code,brch_name From tblCW Where comp_code='" & compcode & "'")

        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)

        While Dr.Read()
            return_CW &= Dr("brch_code").ToString.Trim & ":" & Dr("brch_name").ToString.Trim & "|"
        End While
        Dr.Close()
        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
    Public Sub insert_ddlVal(ByVal uRole$, ByVal ddls As DropDownList, ByVal rtype$)
        Dim lst As ListItem
        strQry = String.Format("sp_SelectCRMSReports '{0}','{1}'", uRole, rtype)
        MyComm = New SqlCommand(strQry, MyConn)
        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)
        If Dr.HasRows Then
            While Dr.Read()
                lst = New ListItem(Dr("report_name"), Dr("report_code"))
                ddls.Items.Add(lst)
            End While
        End If

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Sub
    Public Function return_crmsRepType(ByVal uRole$, ByVal rtype$) As Integer
        strQry = String.Format("sp_SelectCRMSReports '{0}','{1}'", uRole, rtype)
        MyComm = New SqlCommand(strQry, MyConn)
        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)
        If Dr.HasRows Then
            return_crmsRepType = 1
        Else
            return_crmsRepType = 0
        End If

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
    Public Sub save_rtvhistory_log(ByVal ccode$, ByVal bcode$, ByVal rtvno$, ByVal rtvstat$, ByVal uid$, ByVal remarks$)
        strQry = String.Format("sp_InsertRTVLog '{0}','{1}','{2}','{3}','{4}','{5}'", _
        ccode, bcode, rtvno, rtvstat, uid, remarks)
        MyComm = New SqlCommand(strQry, MyConn)
        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        MyComm.ExecuteNonQuery()
        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Sub
    Public Function getUpload_status() As String
        strQry = String.Format("sp_SelectLastDTSUpload")
        MyComm = New SqlCommand(strQry, MyConn)
        Dim cerr% = 0
        Dim stat$ = ""
        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)
        If Dr.HasRows() Then
            While Dr.Read()
                If Dr("run_status") <> "Succeeded" Then cerr += 1
                stat = Dr("Exec_Date")
            End While
            If cerr = 0 Then
                getUpload_status = "Last Update: " & "<font color='green'>" & stat & "</font>"
            Else
                getUpload_status = "Last Update: " & "<font color='red'>" & stat & "</font>"
            End If
        Else
            getUpload_status = "<font color='red'>" & "No New Update." & "</font>"
        End If
        Dr.Close()
        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
    Public Sub populate_ddlrtvstat(ByVal ddls As DropDownList)
        strQry = String.Format("select * from dbo.tblRTVStat")
        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)

        Dim lst As ListItem

        While Dr.Read()
            lst = New ListItem(Dr("rtvstat_code") & "-" & Dr("rtvstat_name"), Dr("rtvstat_code"))
            ddls.Items.Add(lst)
        End While
        Dr.Close()

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Sub
    Public Function return_Bulletin(ByVal compcode$, ByVal brchcode$, ByVal compgroup$) As DataTable
        return_Bulletin = New DataTable
        strQry = String.Format("sp_SelectCRMSBulletin '{0}','{1}','{2}'", compcode, brchcode, compgroup)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        da = New SqlDataAdapter(strQry, MyConn)
        ds = New DataSet()
        da.Fill(ds)
        If MyConn.State = ConnectionState.Open Then MyConn.Close()
        return_Bulletin = ds.Tables(0)
    End Function
    Public Function get_docnos(ByVal ccode$, ByVal bcode$, ByVal doctype$) As String
        get_docnos = String.Empty

        strQry = String.Format("sp_SelectDocNos '{0}','{1}','{2}'", ccode, bcode, doctype)
        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)
        If Dr.HasRows Then
            While Dr.Read()
                get_docnos &= Dr("docno") & ","
            End While
        Else
            get_docnos = ","
        End If
        Dr.Close()
        get_docnos = Left(get_docnos, Len(get_docnos) - 1)

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
    Public Sub populate_ddlCB(ByVal ddls As DropDownList, ByVal ccode$, ByVal bcode$, ByVal strCB$)
        Dim lst As ListItem
        Dim cbs$
        If Trim(strCB) <> "" And InStr(strCB, ",") Then
            Dim spltCB$() = strCB.Split(",")
            For cb As Integer = 0 To spltCB.Length - 1
                cbs = Trim(spltCB(cb))
                If Len(cbs) = 7 Then
                    ccode = Left(cbs, 3)
                    bcode = Right(cbs, 4)
                ElseIf Len(cbs) = 6 Then
                    ccode = Left(cbs, 3)
                    bcode = Right(cbs, 3)
                ElseIf Len(cbs) = 4 Then
                    ccode = Left(cbs, 3)
                    bcode = Right(cbs, 1)
                ElseIf Len(cbs) = 1 Then
                    ccode = cbs
                    bcode = cbs
                End If

                lst = New ListItem(ccode & "-" & bcode, ccode & "-" & bcode)
                ddls.Items.Add(lst)
            Next
        Else
            lst = New ListItem(ccode & "-" & bcode, ccode & "-" & bcode)
            ddls.Items.Add(lst)
        End If
    End Sub

    Public Function return_AckSig(ByVal vcode$, ByVal reld$, ByVal ccode$, ByVal bcode$) As String
        return_AckSig = String.Empty
        Dim recby$ = ""
        strQry = String.Format("sp_ackrecept_signatory '{0}','{1}','{2}','{3}'", vcode, reld, ccode, bcode)
        MyComm = New SqlCommand(strQry, MyConn)
        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)
        If Dr.HasRows Then
            While Dr.Read()
                return_AckSig &= Dr("REL_BY") & ","
                recby = Dr("RECV_BY")
            End While
            return_AckSig &= "|" & recby
        Else
            return_AckSig = ",|"
        End If
        Dr.Close()
        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
    Public Function return_vendor_all() As String
        return_vendor_all = ":|"
        strQry = String.Format("Select vend_code,vend_name From dbo.vendormaster")

        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)

        While Dr.Read()
            return_vendor_all &= Trim(Dr("Vend_Code")) & ":" & Trim(Dr("Vend_Name")) & "|"
        End While
        Dr.Close()
        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
#End Region

#Region " Checking Functions "
    Public Function check_deducted(ByVal rtvno$, ByVal compcode$) As Boolean
        check_deducted = False

        strQry = String.Format("sp_chkDeducted '{0}','{1}'", rtvno, compcode)
        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)

        While Dr.Read()
            If Dr("RTV_Count") > 0 Then check_deducted = True
        End While

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
