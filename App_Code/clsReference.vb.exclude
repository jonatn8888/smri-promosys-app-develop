Imports Microsoft.VisualBasic
Imports System
Imports System.Data
Imports System.Data.SqlClient

Public Class clsRef_General

    Public SQLConn As SqlConnection
    Public SQLCmd As SqlCommand
    Public SQLDa As SqlDataAdapter
    Public SQLDr As SqlDataReader
    Public mds As DataSet
    Public dt As DataTable

#Region " Connection String "
    Private Function sConn() As String
        sConn = ConfigurationManager.AppSettings("ConnectionString")
        Return sConn
    End Function

    Public Property SQLConnString() As String
        Get
            Return sConn()
        End Get
        Set(ByVal Value As String)
            Value = sConn()
        End Set
    End Property
#End Region

#Region " Connection Settings "
    Public Sub closeCon()
        If Not SQLConn Is Nothing Then
            SQLConn.Close()
            SQLConn.Dispose()
        End If
        If Not SQLCmd Is Nothing Then
            SQLCmd.Dispose()
        End If
        If Not SQLDa Is Nothing Then
            SQLDa.Dispose()
        End If
        If Not dt Is Nothing Then
            dt.Dispose()
        End If
    End Sub

    Public Function setCommand(ByVal strSQL As String) As SqlCommand
        SQLConn = New SqlConnection(SQLConnString)
        SQLCmd = New SqlCommand(strSQL, SQLConn)
        Return SQLCmd
    End Function

    Public Function setAdapter(ByVal strSQL As String) As SqlDataAdapter
        SQLConn = New SqlConnection(SQLConnString)
        SQLDa = New SqlDataAdapter(strSQL, SQLConn)
        Return SQLDa
    End Function

    Public Function execDataset(ByVal strSQL As String) As DataSet
        execDataset = New DataSet
        setAdapter(strSQL)
        SQLDa.Fill(execDataset)
        Return execDataset
    End Function

    Public Function execReader(ByVal strSQL As String) As SqlDataReader
        execReader = Nothing
        setCommand(strSQL)

        Try
            If SQLConn.State = ConnectionState.Closed Then
                SQLConn.Open()
            End If
            execReader = SQLCmd.ExecuteReader(CommandBehavior.Default)
            Return execReader
        Catch ex As Exception
            Throw ex
        End Try
    End Function

    Public Sub execSQL(ByVal strSQL As String)
        setCommand(strSQL)
        Try
            If SQLConn.State = ConnectionState.Closed Then
                SQLConn.Open()
            End If
            SQLCmd.ExecuteNonQuery()
        Catch ex As Exception
            Throw ex
        Finally
            closeCon()
        End Try
    End Sub
#End Region

#Region " User-Defined Functions and Procedures "
    Public Function getIndex(ByVal ddl As DropDownList, ByVal strValue As String) As Integer
        Dim i As Integer
        Dim intCount As Integer = 0
        Dim strCombo As String

        For i = 1 To ddl.Items.Count
            ddl.SelectedIndex = intCount
            strCombo = ddl.Text.Trim
            If strCombo = strValue Then
                getIndex = intCount
            End If
            intCount += 1
        Next
    End Function

    Public Function IncrementText(ByVal strSQL As String, ByVal fldValue As String) As Double
        IncrementText = 0
        mds = New DataSet
        setAdapter(strSQL)

        SQLDa.Fill(mds)
        If mds.Tables(0).Rows.Count > 0 Then
            IncrementText = mds.Tables(0).Rows(0)(fldValue).ToString.Trim() + 1
        Else
            IncrementText = 1
        End If
    End Function
#End Region

#Region " Text Validations "
    Public Function trimString(ByVal Value As String, ByVal Trim As String) As String
        'remove invalid characters from a string
        Dim lenValue As Integer = Value.Length
        Dim lenTrim As Integer = Trim.Length
        Dim i As Integer
        Dim count As Integer
        Dim counter As Integer
        Dim getValue As String
        Dim trimValue As String
        trimString = String.Empty

        If lenValue = 0 Then
            trimString = " "
            Exit Function
        End If
        If Value.Trim = String.Empty Then
            trimString = " "
            Exit Function
        End If

        For i = 1 To lenValue
            getValue = Mid(Value, i, 1)
            For count = 1 To lenTrim
                trimValue = Mid(Trim, count, 1)
                If getValue <> trimValue Then
                    counter += 1
                    If counter = lenTrim Then
                        trimString &= getValue
                    End If
                Else
                    Exit For
                End If
            Next
            count = 0
            counter = 0
        Next
    End Function

    Public Function trimLString(ByVal strValue As String) As String
        trimLString = String.Empty
        Dim i As Integer = 0
        Dim boolNumeric As Boolean = False 'check first number if 0
        Dim chkValue As String = String.Empty

        For i = 1 To strValue.Length
            chkValue = Mid(strValue, i, 1)
            If chkValue > 0 Then
                trimLString &= chkValue
                boolNumeric = True
            Else
                If boolNumeric = False Then
                    If chkValue <> 0 Then
                        trimLString &= chkValue
                    End If
                Else
                    If trimLString.Length > 0 Then
                        trimLString &= chkValue
                    End If
                End If
            End If
        Next
    End Function

    Public Function getValue(ByVal strValue As String, ByVal lookValue As String, ByVal endValue As String) As String
        'return the appsetting value in a string
        Dim i As Integer = 0
        Dim j As Integer = 0
        Dim sIndex As Integer = 0
        Dim eIndex As Integer = 0
        Dim count As Integer = 0
        getValue = String.Empty

        sIndex = strValue.IndexOf(lookValue)
        eIndex = strValue.IndexOf(endValue)

        If sIndex = 0 Then
            For j = 0 To lookValue.Length - 1
                strValue = strValue.Remove(0, 1)
            Next
            eIndex = strValue.IndexOf(endValue)
        End If
        If eIndex < sIndex Then
            For i = 0 To sIndex + lookValue.Length - 1
                strValue = strValue.Remove(0, 1)
            Next
            eIndex = strValue.IndexOf(endValue)
        End If

        For count = 1 To eIndex
            getValue &= Mid(strValue, count, 1)
        Next
    End Function

    Public Function inStr(ByVal strValue As String, ByVal intComma As Integer) As String
        If intComma = 0 Then
            inStr = "'" & strValue & "'"
        Else
            inStr = "'" & strValue & "', "
        End If
        Return inStr
    End Function

    Public Function Greetings() As String
        Greetings = String.Empty
        Dim intDate As Integer = Now.TimeOfDay.Hours.ToString
        If intDate >= 0 And intDate < 12 Then
            Greetings = "Good Morning!"
        End If
        If intDate >= 12 And intDate < 18 Then
            Greetings = "Good Afternoon!"
        End If
        If intDate >= 18 And intDate < 24 Then
            Greetings = "Good Evening!"
        End If
        Return Greetings
    End Function

    Public Function NumberFormat(ByVal strValue As String) As Double
        If strValue = String.Empty Then
            Exit Function
        Else
            NumberFormat = strValue
            NumberFormat = Format(NumberFormat, "##,###.#0")
        End If
    End Function

    Public Function GetAppSetting(ByVal Key As String) As String
        Try
            Dim sTemp As String = String.Empty
            sTemp = ConfigurationManager.AppSettings(Key)

            If (sTemp <> String.Empty) Then
                Return sTemp
            Else
                Return String.Empty
            End If
        Catch
            Return String.Empty
        End Try
    End Function

    Public Function FormatDate(ByVal strValue As String, ByVal Format As String) As String
        FormatDate = String.Empty
        Dim strDate(2) As String
        Dim serverDate As String = Now.Year

        Try
            Select Case Format
                Case "yymmdd"
                    strDate(0) = Mid(strValue, 1, 2) 'Year
                    strDate(1) = Mid(strValue, 3, 2) 'Month
                    strDate(2) = Mid(strValue, 5, 2) 'Day
                Case "mmddyy"
                    strDate(0) = Mid(strValue, 5, 2) 'Day
                    strDate(1) = Mid(strValue, 1, 2) 'Year
                    strDate(2) = Mid(strValue, 3, 2) 'Month
            End Select

            If strDate(0).Length = 2 Then
                strDate(0) = Mid(serverDate, 1, 2) & strDate(0)
            End If
            FormatDate = strDate(0) & "-" & strDate(1) & "-" & strDate(2)
        Catch ex As Exception

        End Try
    End Function
#End Region

#Region " SQL Validations "
    Public Function HasRows(ByVal strSQL As String) As Boolean
        HasRows = False
        Try
            SQLDr = execReader(strSQL)
            If SQLDr.HasRows Then
                Return True
            Else
                Return False
            End If
        Catch ex As Exception
        Finally
            closeCon()
        End Try
    End Function
#End Region

