    Public Function newConn() As SqlConnection
        newConn = MyConn
    End Function

#Region " System Specific Routines"
    Public Sub able_chkb(ByVal gv As GridView, ByVal chk As CheckBox, ByVal btn As Button)
        If gv.Rows.Count > 0 Then
            chk.Enabled = True
            btn.Enabled = True
        Else
            chk.Checked = False
            chk.Enabled = False
            btn.Enabled = False
        End If
    End Sub
    Public Function return_tblCW(ByVal compcode As String) As DataTable
        return_tblCW = New DataTable
        strQry = String.Format("sp_getCW '{0}'", compcode)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        da = New SqlDataAdapter(strQry, MyConn)
        ds = New DataSet()
        da.Fill(ds)
        If MyConn.State = ConnectionState.Open Then MyConn.Close()
        return_tblCW = ds.Tables(0)
    End Function
