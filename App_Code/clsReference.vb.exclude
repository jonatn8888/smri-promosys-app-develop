    Public Function return_compdetails(ByVal compcode As String) As String
        return_compdetails = String.Empty
        strQry = String.Format("sp_getcompinfo '{0}'", compcode)
        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)

        While Dr.Read()
            return_compdetails = Dr("COMP_NAME")
        End While

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
