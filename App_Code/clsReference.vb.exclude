    Public Shared Sub CreateMessageAlert(ByRef aspxPage As System.Web.UI.Page, _
                           ByVal strMessage As String, ByVal strKey As String)
        Dim strScript As String = "<script language=JavaScript>alert('" _
                                            & strMessage & "')</script>"
        Dim cstype As Type = aspxPage.GetType()

        If (Not aspxPage.ClientScript.IsStartupScriptRegistered(strKey)) Then
            aspxPage.ClientScript.RegisterStartupScript(cstype, strKey, strScript)
        End If
        'If (Not aspxPage.IsStartupScriptRegistered(strKey)) Then
        '    aspxPage.RegisterStartupScript(strKey, strScript)
        'End If
    End Sub

    Public Shared Sub AlertMsgFocTxt(ByRef aspxPage As System.Web.UI.Page, _
                        ByVal txtobj As WebControl, ByVal msg As String, ByVal strKey As String)
        Dim cScript As String = "<script language='javascript'>alert('" & msg & "');" & _
                                "document.getElementById('" & txtobj.ClientID & "').select();" & _
                                "</script>"
        Dim cstype As Type = aspxPage.GetType()

        If (Not aspxPage.ClientScript.IsStartupScriptRegistered(strKey)) Then
            aspxPage.ClientScript.RegisterStartupScript(cstype, strKey, cScript)
        End If
    End Sub

    Public Shared Sub AlertMsgRedirect(ByRef aspxPage As System.Web.UI.Page, _
                          ByVal strMessage As String, ByVal url As String, ByVal strKey As String)
        Dim strScript As String = "<script language=JavaScript>alert('" _
                                            & strMessage & "');location.href='" & url & "';</script>"
        Dim cstype As Type = aspxPage.GetType()

        If (Not aspxPage.ClientScript.IsStartupScriptRegistered(strKey)) Then
            aspxPage.ClientScript.RegisterStartupScript(cstype, strKey, strScript)
        End If
        'If (Not aspxPage.IsStartupScriptRegistered(strKey)) Then
        '    aspxPage.RegisterStartupScript(strKey, strScript)
        'End If
    End Sub
    Public Shared Sub AlertMsgClose(ByRef aspxPage As System.Web.UI.Page, _
                          ByVal strMessage As String, ByVal strKey As String)
        Dim strScript As String = "<script language=JavaScript>alert('" _
                                            & strMessage & "');window.close();</script>"
        Dim cstype As Type = aspxPage.GetType()

        If (Not aspxPage.ClientScript.IsStartupScriptRegistered(strKey)) Then
            aspxPage.ClientScript.RegisterStartupScript(cstype, strKey, strScript)
        End If
        'If (Not aspxPage.IsStartupScriptRegistered(strKey)) Then
        '    aspxPage.RegisterStartupScript(strKey, strScript)
        'End If
    End Sub
#End Region
End Class

Public Class clsCRMS
    Dim MyConn As New SqlConnection(ConfigurationManager.AppSettings("ConnectionString"))
