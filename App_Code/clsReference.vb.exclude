    Public Function ddl_selected(ByVal ddls As DropDownList, ByVal txtcompare As String, ByVal func As String) As String
        ddl_selected = String.Empty
        For ct As Integer = 0 To ddls.Items.Count - 1
            If ddls.Items(ct).Text = txtcompare Then
                ddls.SelectedIndex = ct
                Exit For
            End If
        Next
        Select Case func
            Case "comp"
                ddl_selected = return_compdetails(txtcompare)
            Case "brch"
                ddl_selected = return_brchdetail(txtcompare)
            Case "cw"
                ddl_selected = ddls.SelectedValue
        End Select

    End Function
