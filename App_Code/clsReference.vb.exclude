    Public Function val_act(ByVal rtvno$, ByVal compcode$) As String
        val_act = ""
        strQry = "Select ACT From CBRMASTH Where RTV_NO='" & rtvno & "' And COMP_FR='" & compcode & "'"
        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)
        While Dr.Read()
            If Not IsDBNull(Dr("ACT")) Then val_act = Dr("ACT") Else val_act = ""
        End While

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
    Public Function return_ReleaseLoc(ByVal rtvno$, ByVal compcode$) As String
        return_ReleaseLoc = ""
        strQry = "Select Pickup_br From CBRMASTH Where RTV_NO='" & rtvno & "' And COMP_FR='" & compcode & "'"
        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)
        While Dr.Read()
            If Not IsDBNull(Dr("Pickup_br")) Then return_ReleaseLoc = Trim(Dr("Pickup_br")) Else return_ReleaseLoc = ""
        End While

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Function
    Public Function return_CWTag(ByVal rtvno$, ByVal compcode$) As Boolean
