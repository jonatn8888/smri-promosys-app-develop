    Public Sub populate_ComboCW(ByVal compcode$, ByVal ddls As DropDownList)
        strQry = String.Format("sp_getCW '{0}'", compcode)
        MyComm = New SqlCommand(strQry, MyConn)

        If MyConn.State = ConnectionState.Closed Then MyConn.Open()
        Dr = MyComm.ExecuteReader(CommandBehavior.CloseConnection)

        ddls.Items.Clear()

        Dim lst As ListItem

        lst = New ListItem(" ", " ")
        ddls.Items.Add(lst)

        While Dr.Read()
            lst = New ListItem(Dr("brch_code"), Dr("brch_name"))
            ddls.Items.Add(lst)
        End While
        Dr.Close()

        If MyConn.State = ConnectionState.Open Then MyConn.Close()
    End Sub
