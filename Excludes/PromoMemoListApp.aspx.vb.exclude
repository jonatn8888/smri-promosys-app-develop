    Protected Sub gridRequests_RowDataBound(ByVal sender As Object, ByVal e As System.Web.UI.WebControls.GridViewRowEventArgs) Handles gridRequests.RowDataBound

        Dim sRedTag As String = ""
        Dim lb As Label = e.Row.FindControl("lblMemoID")

        If e.Row.RowType = DataControlRowType.DataRow Then
            If DateDiff(DateInterval.Day, Today(), CDate(e.Row.Cells(3).Text)) < 4 Then sRedTag = "style='color: red'"

            e.Row.Cells(2).Text = "<a href='PromoMemo.aspx?MemoID=" & lb.Text & "'><span " & sRedTag & ">" & e.Row.Cells(2).Text & "</a>"
        End If

    End Sub

    Protected Sub Page_Load(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.Load

        '::ToDo:: authenticate User
        If (Session("UserID") = Nothing) Or (Session("UserID") = 0) Or (Session("UserLevel") = Nothing) Or (Session("UserLevel") > 4) Then Response.Redirect("InvalidAccess.aspx")

        Session.Remove("CurrMemoID")

        If Not IsPostBack() Then

            Select Case CInt(Session("UserLevel"))

                Case 4      ' MPD Analyst

                    With cboFilterStatus
                        .Items.Add(New ListItem("Memos Submitted for Review", "For Review"))
                        .Items.Add(New ListItem("Memos for CSY Approval", "For CSY Approval"))
                        .Items.Add(New ListItem("Approved Memos", "Approved"))
                    End With

                Case 3      ' Reviewer

                    With cboFilterStatus
                        .Items.Add(New ListItem("Memos for Review", "For Review"))
                        .Items.Add(New ListItem("Memos for CSY Approval", "For CSY Approval"))
                        .Items.Add(New ListItem("Approved Memos", "Approved"))
                    End With

                Case 2  ' CSY

                    With cboFilterStatus
                        .Items.Add(New ListItem("Memos Awaiting Your Approval", "FOR CSY Approval"))
                        .Items.Add(New ListItem("Memos for Review", "For Review"))
                        .Items.Add(New ListItem("Approved Memos", "Approved"))
                        .Items.Add(New ListItem("Special Requests", "Special Request"))

                    End With

            End Select

            cboFilterStatus.SelectedIndex = 0

        End If

    End Sub

    Protected Sub cboFilterStatus_SelectedIndexChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles cboFilterStatus.SelectedIndexChanged

        If cboFilterStatus.SelectedValue = "Special Request" Then
            gridRequests.Visible = False
            ' Panel1.Visible = True
        Else

            'Panel1.Visible = False
            gridRequests.Visible = True

            sqldsRequests.SelectCommand = "SELECT * FROM Memos WHERE Status = '" & cboFilterStatus.SelectedValue & "' ORDER BY MemoDate"
        End If

    End Sub
End Class
