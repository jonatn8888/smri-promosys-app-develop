<%@ Page Language="VB" AutoEventWireup="false" CodeFile="SysUserMaint.aspx.vb" Inherits="SysUserMaint" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head runat="server">
    <title>Untitled Page</title>
    
    <STYLE TYPE="text/css">
        a:link { color: black; text-decoration: none }
        a:active { color: black; text-decoration: none }
        a:visited { color: black; text-decoration: none }
        a:hover { color: orange; text-decoration: none }
    </STYLE>    
</head>
<body style="font-size: 12pt">
    <form id="form1" runat="server">
    <div>
        <br />
        <span style="font-family: Trebuchet MS; font-size: 14pt">Users Maintenance</span>
        <br /><br />

        <span style="font-family: Trebuchet MS; font-size: 10pt">        
        <asp:GridView ID="gridUsers" runat="server" AutoGenerateColumns="False"
            CellPadding="4" DataKeyNames="UserID" DataSourceID="sqldsUsers" ForeColor="#333333"
            GridLines="Vertical" Width="549px" BorderWidth="1px" AllowSorting="True">
            <RowStyle BackColor="#F7F6F3" ForeColor="#333333" />
            <Columns>
                <asp:TemplateField>
                    <ItemTemplate>
                        <asp:CheckBox ID="chkRowSel" runat="server" />
                    </ItemTemplate>
                    <ItemStyle Width="5px" />
                </asp:TemplateField>
                <asp:TemplateField Visible="False">
                    <ItemTemplate>
                        <asp:Label ID="lblRowID" runat="server" Text='<%# Eval("UserID") %>' Width="40px"></asp:Label>
                    </ItemTemplate>
                </asp:TemplateField>
                <asp:BoundField DataField="UserID" HeaderText="UserID" InsertVisible="False" ReadOnly="True"
                    SortExpression="UserID" Visible="False" />
                <asp:BoundField DataField="UserName" HeaderText="Login Name" SortExpression="UserName">
                    <ItemStyle Width="100px" />
                </asp:BoundField>
                <asp:BoundField DataField="SignName" HeaderText="Full Name" SortExpression="SignName" />
                <asp:BoundField DataField="UserDept" HeaderText="Dept" SortExpression="UserDept">
                    <ItemStyle Width="80px" />
                </asp:BoundField>
            </Columns>
            <FooterStyle BackColor="#5D7B9D" Font-Bold="True" ForeColor="White" />
            <PagerStyle BackColor="#284775" ForeColor="White" HorizontalAlign="Center" />
            <SelectedRowStyle BackColor="#E2DED6" Font-Bold="True" ForeColor="#333333" />
            <HeaderStyle BackColor="#5D7B9D" Font-Bold="True" ForeColor="White" />
            <EditRowStyle BackColor="#999999" />
            <AlternatingRowStyle BackColor="White" ForeColor="#284775" />
        </asp:GridView>
        <asp:SqlDataSource ID="sqldsUsers" runat="server" ConnectionString="<%$ ConnectionStrings:PromoConnectionString %>"
            DeleteCommand="DELETE FROM Users WHERE UserID = @UserID" SelectCommand="SELECT * FROM Users">
            <DeleteParameters>
                <asp:Parameter Name="UserID" />
            </DeleteParameters>
        </asp:SqlDataSource>
        <br />
    </span>

    </div>
        &nbsp;
        <table>
            <tr>
                <td style="width: 92px">
                </td>
                <td style="width: 146px">
                </td>
                <td style="width: 108px">
                </td>
                <td style="width: 131px">
                </td>
                <td style="width: 89px">
                </td>
            </tr>
            <tr>
                <td style="width: 92px">
                    <asp:Button ID="cmdAdd" runat="server" Text="Add New" Width="84px" /></td>
                <td style="width: 146px">
                    <asp:Button ID="cmdEdit" runat="server" Text="Edit" Width="84px" /></td>
                <td style="width: 108px">
                    <asp:Button ID="cmdDelete" runat="server" Text="Delete" Width="102px" /></td>
                <td style="width: 131px">
                </td>
                <td style="width: 89px">
                    <asp:Button ID="cmdDone" runat="server" Text="Done" Width="84px" /></td>
            </tr>
            <tr>
                <td style="width: 92px; height: 13px">
                </td>
                <td style="width: 146px; height: 13px">
                </td>
                <td style="width: 108px; height: 13px">
                </td>
                <td style="width: 131px; height: 13px">
                </td>
                <td style="width: 89px; height: 13px">
                </td>
            </tr>
        </table>
        <asp:Label ID="Label1" runat="server" Text="Label" Width="244px"></asp:Label>
    </form>
</body>
</html>
